{
  "expo": {
    "name": "Her 75",
    "slug": "her75",
    "scheme": "her75",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.her75.app"
    },
    "android": {
      "package": "com.her75.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F5F0"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Her 75 uses the camera so you can photograph today's tasks as you finish them.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Her 75 shows your photo library so you can pick a photo for today's tasks.",
          "savePhotosPermission": "Her 75 saves the photos you take for your tasks back to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
