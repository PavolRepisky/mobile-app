# Copy to .env.local (git-ignored) and fill in.
#
# Local stack: `npm run db:start` prints both. From a phone running Expo Go,
# use this computer's LAN address instead of 127.0.0.1, e.g.
# http://192.168.1.20:54321.
#
# Hosted project: Supabase dashboard → Project Settings → API — the Project
# URL and the anon / publishable key. Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
